# ---------------------------------------------------------------------------
# SolvePilot environment template
#
# Copy to .env.local and fill in real values:  cp .env.example .env.local
# Never commit real credentials. .env* files are git-ignored except this one.
#
# Every variable is validated (and defaulted) in lib/config/env.ts.
# Variables that are only needed by a feature are required the moment that
# feature executes, so the landing page can run before Mongo/OpenAI/S3 exist.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# debug | info | warn | error  (defaults to debug in dev, info in production)
LOG_LEVEL=debug

# --- Public app config (safe to expose to the browser) ---------------------
# Absolute base URL used for metadata, share links and report links.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=SolvePilot

# --- Database (MongoDB) ----------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/solvepilot
# Atlas:  mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
# Verify the connection and create indexes with: npm run db:verify
MONGODB_URI=
# Optional override when the database name is not part of the URI.
MONGODB_DB_NAME=solvepilot

# --- Authentication (Auth.js) ---------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Canonical deployment URL; also used as the OAuth callback base.
AUTH_URL=http://localhost:3000
# Set to true behind a proxy/load balancer that terminates TLS.
AUTH_TRUST_HOST=true

# --- AI (OpenAI, server-side only) ----------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_TIMEOUT_MS=60000

# --- Object storage (S3-compatible: AWS S3, R2, MinIO, Spaces) ------------
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
# Required by MinIO and most self-hosted S3 gateways.
STORAGE_FORCE_PATH_STYLE=false

# --- Upload limits (bytes) -------------------------------------------------
UPLOAD_MAX_IMAGE_BYTES=8388608
UPLOAD_MAX_DOCUMENT_BYTES=20971520
UPLOAD_MAX_AUDIO_BYTES=26214400

# --- PDF reports (Puppeteer) ----------------------------------------------
PDF_ENABLED=true
# Only set when using a system Chromium instead of the bundled browser.
PUPPETEER_EXECUTABLE_PATH=
